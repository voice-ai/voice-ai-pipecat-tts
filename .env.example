# Voice.AI TTS Service - Environment Variables
# ==============================================
# Copy this file to .env and fill in your API keys

# Voice.AI Configuration (Required for all examples)
# Get your API key from: https://voice.ai
VOICEAI_API_KEY=vk_your_voice_ai_key_here

# Optional: Custom Voice ID (if using your own cloned voice)
# VOICEAI_VOICE_ID=your_custom_voice_id

# OpenAI Configuration (Required for pipeline_example.py and microphone_example.py)
# Needed for:
# - Whisper STT (speech-to-text)
# - GPT LLM (language model)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk_your_openai_key_here

# ==============================================
# Example Requirements:
# 
# simple_tts.py          → VOICEAI_API_KEY
# microphone_example.py  → VOICEAI_API_KEY + OPENAI_API_KEY
# ==============================================

